# ---------------------------------------------------------------------------
# Database (Neon)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and replace the value with your Neon connection
# string. Neon requires TLS, so keep `?sslmode=require` at the end.
#
#   neon link --project-id crimson-recipe-10425940 --branch production -y
#   neon connection-string production
#
# Example shape (do not commit the real credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Passkey used by the admin sign-in dialog (triple-click the logo, or use the
# "Admin sign in" button). Change this before going live.
ADMIN_PASSKEY=5309
